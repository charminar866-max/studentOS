# .env.example — copy to .env.local and fill with real values (do not commit)
# Adzuna API Keys (Get from: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# OpenAI API Key (Get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase Credentials (Get from: https://supabase.com/)
NEXT_PUBLIC_SUPABASE_URL=
# Public / anon key for browser-side clients (safe to expose)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backward-compatible alias (anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret/service-role key (NEVER expose this in browser)
SUPABASE_SERVICE_ROLE_KEY=

# OAuth / App URLs
NEXT_PUBLIC_OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000
