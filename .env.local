# Sanitized local env file — do NOT commit secrets into the repository.
# This file is intentionally cleared of real secrets. Create a local .env.local
# with real values (not committed) following .env.example.

# Adzuna API Keys (set in your local .env.local or CI secrets)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OAuth / App URLs - local defaults
NEXT_PUBLIC_OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000
